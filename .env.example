
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=recoverx
DB_PORT=3306
API_KEY=recoverx-secret-key

# Optional SMTP configuration for alert emails.
# SMTP_HOST must be non-empty for real delivery; otherwise emails are
# logged only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Comma or semicolon separated list of email recipients for alerts.
ALERT_EMAIL_RECIPIENTS=admin1@example.com,admin2@example.com

